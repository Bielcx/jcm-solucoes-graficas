---
// Configurador 3D de caixa personalizada — MVP.
// TODO: faixas de comprimento/largura/altura abaixo são estimadas (sem dados
// reais de produção ainda). Ajustar assim que tivermos os limites reais da JCM.
// TODO: hoje só cobre "caixa". Outros formatos (sacola, copo) ficam pra depois.
const sliders = [
  { key: 'comprimento', sigla: 'C', label: 'Comprimento', min: 15, max: 60, valor: 28 },
  { key: 'largura', sigla: 'L', label: 'Largura', min: 10, max: 40, valor: 22 },
  { key: 'altura', sigla: 'A', label: 'Altura', min: 5, max: 30, valor: 9 },
];
---

<div
  class="grid grid-cols-[repeat(auto-fit,minmax(min(320px,100%),1fr))] overflow-hidden rounded-[10px] border border-cream-border shadow-[0_12px_40px_rgba(34,27,18,0.08)]"
>
  <!-- Painel de controles -->
  <div class="flex flex-col gap-6 bg-surface p-[28px_26px]">
    <div>
      <p class="font-display text-[11px] font-bold uppercase tracking-[0.18em] text-ink-faint">
        Formato
      </p>
      <div class="mt-2.5 flex flex-wrap gap-2">
        <button
          type="button"
          class="rounded-full border border-olive-500 bg-olive-500 px-5 py-2 font-display text-[13px] font-semibold text-cream"
        >
          Caixa
        </button>
        {
          ['Sacola', 'Copo'].map((formato) => (
            <button
              type="button"
              disabled
              class="cursor-not-allowed rounded-full border border-dashed border-[#d5cab0] px-5 py-2 font-display text-[13px] font-semibold text-ink-faint"
            >
              {formato}
              <span class="ml-1.5 text-[9px] uppercase tracking-[0.1em] text-[#c0b498]">
                em breve
              </span>
            </button>
          ))
        }
      </div>
    </div>

    <div class="flex flex-col gap-[22px]">
      {
        sliders.map((s) => (
          <div>
            <div class="flex items-baseline justify-between gap-3">
              <label
                for={`bc-${s.key}`}
                class="font-display text-[11px] font-bold uppercase tracking-[0.14em] text-ink"
              >
                {s.label}
              </label>
              <span
                id={`bc-${s.key}-valor`}
                class="font-display text-[15px] font-bold whitespace-nowrap tabular-nums text-olive-500"
              >
                {s.valor} cm
              </span>
            </div>
            <input
              id={`bc-${s.key}`}
              type="range"
              class="bc-slider mt-2.5"
              min={s.min}
              max={s.max}
              step="1"
              value={s.valor}
            />
            <div class="mt-[5px] flex justify-between text-[10.5px] tabular-nums text-[#c0b498]">
              <span>{s.min} cm</span>
              <span>{s.max} cm</span>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Ficha -->
    <div
      class="flex flex-wrap items-center justify-between gap-4 rounded-lg border border-dashed border-[#c9bfa6] bg-cream p-[16px_18px]"
    >
      <div>
        <p class="font-display text-[11px] font-bold uppercase tracking-[0.14em] text-ink-faint">
          Sua caixa
        </p>
        <p
          id="bc-resumo"
          class="mt-1 font-display text-[19px] font-bold whitespace-nowrap tabular-nums text-ink"
        >
          28 × 22 × 9 cm
        </p>
      </div>
      <div class="text-right">
        <p class="font-display text-[11px] font-bold uppercase tracking-[0.14em] text-ink-faint">
          Volume aprox.
        </p>
        <p
          id="bc-volume"
          class="mt-1 font-display text-[19px] font-bold whitespace-nowrap tabular-nums text-olive-500"
        >
          ≈ 5,5 L
        </p>
      </div>
    </div>

    <div class="flex flex-col gap-2.5">
      <a
        id="bc-whatsapp"
        href="#"
        target="_blank"
        rel="noopener"
        class="block rounded-md bg-olive-500 py-3.5 text-center font-display text-[14px] font-semibold whitespace-nowrap text-cream hover:bg-olive-600"
      >
        Pedir orçamento no WhatsApp
      </a>
      <p class="text-[11.5px] leading-normal text-ink-faint">
        Medidas de referência — a produção confirma os limites exatos com você.
      </p>
    </div>
  </div>

  <!-- Viewport 3D -->
  <div
    class="relative min-h-[380px] overflow-hidden bg-ink-inverse [background-image:radial-gradient(rgba(246,241,228,0.07)_1px,transparent_1px)] [background-size:26px_26px]"
  >
    <div
      class="absolute inset-0 [background:radial-gradient(ellipse_at_50%_55%,rgba(138,156,85,0.10),transparent_60%)]"
    >
    </div>

    <!-- Readout técnico -->
    <div
      class="absolute top-4 left-[18px] z-10 flex gap-3.5 font-mono text-[11px] tracking-[0.06em] text-cream/55"
    >
      {
        sliders.map((s) => (
          <span>
            {s.sigla} <span id={`bc-${s.key}-readout`} class="text-olive-300">{s.valor}</span>
          </span>
        ))
      }
      <span class="text-cream/30">cm</span>
    </div>

    <!-- Brackets de viewfinder -->
    <div class="absolute top-3.5 left-3.5 size-4 border-t border-l border-cream/30"></div>
    <div class="absolute top-3.5 right-3.5 size-4 border-t border-r border-cream/30"></div>
    <div class="absolute bottom-3.5 left-3.5 size-4 border-b border-l border-cream/30"></div>
    <div class="absolute bottom-3.5 right-3.5 size-4 border-b border-r border-cream/30"></div>

    <div id="bc-canvas-wrap" class="absolute inset-0"></div>

    <p class="absolute right-0 bottom-3 left-0 z-10 text-center text-[11px] text-cream/35">
      Arraste para girar · Scroll para zoom
    </p>
  </div>
</div>

<style>
  .bc-slider {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 4px;
    margin: 0;
    border-radius: 2px;
    outline: none;
    cursor: pointer;
  }
  /* trilha preenchida vem de um gradiente inline atualizado no JS */
  .bc-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    box-sizing: border-box;
    width: 20px;
    height: 20px;
    border: 6px solid #55632f;
    border-radius: 50%;
    background: #f6f1e4;
    box-shadow: 0 1px 4px rgba(34, 27, 18, 0.25);
    cursor: grab;
    transition: transform 120ms ease;
  }
  .bc-slider::-webkit-slider-thumb:hover {
    transform: scale(1.12);
  }
  .bc-slider::-webkit-slider-thumb:active {
    cursor: grabbing;
  }
  .bc-slider::-moz-range-thumb {
    box-sizing: border-box;
    width: 20px;
    height: 20px;
    border: 6px solid #55632f;
    border-radius: 50%;
    background: #f6f1e4;
    box-shadow: 0 1px 4px rgba(34, 27, 18, 0.25);
    cursor: grab;
  }
  .bc-slider:focus-visible {
    box-shadow: 0 0 0 3px rgba(85, 99, 47, 0.25);
  }
</style>

<script>
  import * as THREE from 'three';
  import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';
  import { buildWhatsAppLink } from '../data/config';

  const wrap = document.getElementById('bc-canvas-wrap');
  const comprimentoInput = document.getElementById('bc-comprimento') as HTMLInputElement;
  const larguraInput = document.getElementById('bc-largura') as HTMLInputElement;
  const alturaInput = document.getElementById('bc-altura') as HTMLInputElement;
  const comprimentoValor = document.getElementById('bc-comprimento-valor');
  const larguraValor = document.getElementById('bc-largura-valor');
  const alturaValor = document.getElementById('bc-altura-valor');
  const comprimentoReadout = document.getElementById('bc-comprimento-readout');
  const larguraReadout = document.getElementById('bc-largura-readout');
  const alturaReadout = document.getElementById('bc-altura-readout');
  const resumo = document.getElementById('bc-resumo');
  const volumeEl = document.getElementById('bc-volume');
  const whatsappBtn = document.getElementById('bc-whatsapp') as HTMLAnchorElement;

  if (wrap) {
    // --- cena base ---
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(
      40,
      wrap.clientWidth / wrap.clientHeight || 1,
      0.1,
      100
    );
    camera.position.set(5, 4.5, 6);

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(wrap.clientWidth, wrap.clientHeight);
    wrap.appendChild(renderer.domElement);

    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.08;
    controls.enablePan = false;
    controls.minDistance = 3;
    controls.maxDistance = 16;
    controls.target.set(0, 0.8, 0);

    // grade de chão, mesmo espírito do line-art do site
    const grid = new THREE.GridHelper(14, 14, 0x55632f, 0x2a2318);
    (grid.material as THREE.Material).transparent = true;
    (grid.material as THREE.Material).opacity = 0.5;
    scene.add(grid);

    // --- caixa ---
    const CM_TO_UNIT = 1 / 10; // 10cm ≈ 1 unidade de cena

    const boxGroup = new THREE.Group();
    scene.add(boxGroup);

    const fillMaterial = new THREE.MeshBasicMaterial({
      color: 0xa0b46a,
      transparent: true,
      opacity: 0.08,
      side: THREE.DoubleSide,
    });
    const edgeMaterial = new THREE.LineBasicMaterial({ color: 0x8a9c55 });

    // Geometrias unitárias criadas uma vez; as medidas viram escala (nada de rebuild).
    const unitBox = new THREE.BoxGeometry(1, 1, 1);
    const unitBoxEdges = new THREE.EdgesGeometry(unitBox);
    const unitFlap = new THREE.PlaneGeometry(1, 1).translate(0, 0.5, 0); // pivô na dobra
    const unitFlapEdges = new THREE.EdgesGeometry(unitFlap);

    const body = new THREE.Group();
    body.add(new THREE.Mesh(unitBox, fillMaterial));
    body.add(new THREE.LineSegments(unitBoxEdges, edgeMaterial));
    boxGroup.add(body);

    // Caixa RSC: 4 abas superiores. Cada aba = hinge (posição/orientação da dobra)
    // > fold (ângulo de abertura) > sizer (escala em cm).
    // ponytail: abertura fixa; virar slider se pedirem "caixa fechada/aberta".
    const ABERTURA = THREE.MathUtils.degToRad(115);
    const flaps = [
      { giro: 0, eixo: 'z', sinal: 1 }, // frente
      { giro: Math.PI, eixo: 'z', sinal: -1 }, // trás
      { giro: Math.PI / 2, eixo: 'x', sinal: 1 }, // direita
      { giro: -Math.PI / 2, eixo: 'x', sinal: -1 }, // esquerda
    ].map((aba) => {
      const hinge = new THREE.Group();
      hinge.rotation.y = aba.giro;
      const fold = new THREE.Group();
      fold.rotation.x = ABERTURA;
      const sizer = new THREE.Group();
      sizer.add(new THREE.Mesh(unitFlap, fillMaterial));
      sizer.add(new THREE.LineSegments(unitFlapEdges, edgeMaterial));
      fold.add(sizer);
      hinge.add(fold);
      boxGroup.add(hinge);
      return { ...aba, hinge, sizer };
    });

    /** Pinta a trilha do slider até a posição atual. */
    function pintarTrilha(input: HTMLInputElement) {
      const min = Number(input.min);
      const pct = ((Number(input.value) - min) / (Number(input.max) - min)) * 100;
      input.style.background = `linear-gradient(to right, #55632f ${pct}%, #e4dbc7 ${pct}%)`;
    }

    function atualizarCaixa() {
      const comprimento = Number(comprimentoInput.value);
      const largura = Number(larguraInput.value);
      const altura = Number(alturaInput.value);

      const c = comprimento * CM_TO_UNIT;
      const l = largura * CM_TO_UNIT;
      const a = altura * CM_TO_UNIT;

      body.scale.set(c, a, l);
      body.position.y = a / 2;

      flaps.forEach(({ eixo, sinal, hinge, sizer }) => {
        const frenteOuTras = eixo === 'z';
        hinge.position.set(frenteOuTras ? 0 : (sinal * c) / 2, a, frenteOuTras ? (sinal * l) / 2 : 0);
        // aba cobre metade da medida oposta à dobra
        sizer.scale.set(frenteOuTras ? c : l, (frenteOuTras ? l : c) / 2, 1);
      });

      controls.target.set(0, a / 2, 0);

      if (comprimentoValor) comprimentoValor.textContent = `${comprimento} cm`;
      if (larguraValor) larguraValor.textContent = `${largura} cm`;
      if (alturaValor) alturaValor.textContent = `${altura} cm`;
      if (comprimentoReadout) comprimentoReadout.textContent = String(comprimento);
      if (larguraReadout) larguraReadout.textContent = String(largura);
      if (alturaReadout) alturaReadout.textContent = String(altura);
      if (resumo) resumo.textContent = `${comprimento} × ${largura} × ${altura} cm`;
      if (volumeEl) {
        const litros = (comprimento * largura * altura) / 1000;
        volumeEl.textContent = `≈ ${litros.toLocaleString('pt-BR', {
          minimumFractionDigits: 1,
          maximumFractionDigits: 1,
        })} L`;
      }
      whatsappBtn.href = buildWhatsAppLink(
        [
          'Olá! Quero um orçamento pra uma caixa personalizada:',
          '',
          `Comprimento: ${comprimento} cm`,
          `Largura: ${largura} cm`,
          `Altura: ${altura} cm`,
          '',
          '(Medidas de referência — posso ajustar conforme a produção.)',
        ].join('\n')
      );
    }

    [comprimentoInput, larguraInput, alturaInput].forEach((input) =>
      input.addEventListener('input', () => {
        pintarTrilha(input);
        atualizarCaixa();
      })
    );
    [comprimentoInput, larguraInput, alturaInput].forEach(pintarTrilha);
    atualizarCaixa();

    function onResize() {
      if (!wrap) return;
      const w = wrap.clientWidth || 1;
      const h = wrap.clientHeight || 1;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
    }
    window.addEventListener('resize', onResize);
    new ResizeObserver(onResize).observe(wrap);

    function animate() {
      requestAnimationFrame(animate);
      controls.update();
      renderer.render(scene, camera);
    }
    animate();
  }
</script>
