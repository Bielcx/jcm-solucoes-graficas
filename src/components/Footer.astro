---
import { siteConfig } from '../data/config';
---

<footer class="border-t border-gray-200 bg-gray-50">
  <div class="mx-auto max-w-6xl px-4 py-8 text-sm text-gray-600">
    <p class="font-semibold text-gray-900">{siteConfig.nome}</p>
    <p class="mt-1">{siteConfig.cidade}</p>
    <p class="mt-1">
      {siteConfig.email} · {siteConfig.instagram}
    </p>
    <p class="mt-4 text-xs text-gray-400">
      Pedidos e orçamentos finalizados via WhatsApp. Valores sujeitos a confirmação.
    </p>
  </div>
</footer>
