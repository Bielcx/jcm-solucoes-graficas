---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Carrinho">
  <div class="mx-auto max-w-[720px] px-4 pb-18 pt-14">
    <p class="font-display text-xs font-semibold uppercase tracking-[0.22em] text-olive-500">
      Seu pedido
    </p>
    <h1 class="mt-3 font-display text-[clamp(28px,3.5vw,40px)] font-bold text-ink">
      Nota de pedido
    </h1>
    <p class="mt-2.5 text-[15px] text-ink-soft">Confira os itens antes de mandar pro WhatsApp.</p>

    <div class="mt-7 overflow-hidden rounded-lg border border-cream-border bg-surface">
      <div
        class="flex items-center justify-between bg-[#f0ead9] px-[22px] py-[14px] font-display text-[11px] font-bold uppercase tracking-[0.14em] text-ink-soft"
      >
        <span>Item</span>
        <span>Subtotal</span>
      </div>

      <div id="cart-empty" class="hidden px-[22px] py-12 text-center text-ink-soft">
        <p>Seu carrinho está vazio.</p>
        <a
          href="/catalogo"
          class="mt-2.5 inline-block font-display font-semibold text-olive-500 hover:text-olive-600"
        >
          Ver catálogo →
        </a>
      </div>

      <div id="cart-items"></div>

      <div id="cart-summary" class="hidden border-t border-dashed border-[#c9bfa6] px-[22px] py-5">
        <div class="flex items-center justify-between font-display text-lg font-bold text-ink">
          <span>Total estimado</span>
          <span id="cart-total" class="whitespace-nowrap">R$ 0,00</span>
        </div>
        <p class="mt-1.5 text-[12.5px] text-ink-faint">
          Valor sujeito a confirmação de frete e disponibilidade.
        </p>
      </div>
    </div>

    <div id="cart-actions" class="mt-5 hidden">
      <a
        id="checkout-link"
        href="#"
        target="_blank"
        rel="noopener"
        class="block rounded-md bg-olive-500 py-[15px] text-center font-display text-[15px] font-semibold text-cream hover:bg-olive-600"
      >
        Finalizar pedido pelo WhatsApp
      </a>
      <button
        id="clear-cart"
        class="mt-2.5 w-full rounded-md border border-cream-border py-[11px] text-[13.5px] font-medium text-ink-soft hover:border-terracotta-400 hover:text-terracotta-600"
      >
        Esvaziar carrinho
      </button>
    </div>
  </div>

  <script>
    import { mountCartUI } from '../scripts/cart';

    mountCartUI({
      itemsEl: document.getElementById('cart-items')!,
      emptyEl: document.getElementById('cart-empty')!,
      summaryEl: document.getElementById('cart-summary')!,
      totalEl: document.getElementById('cart-total')!,
      checkoutLink: document.getElementById('checkout-link') as HTMLAnchorElement,
      clearBtn: document.getElementById('clear-cart'),
      actionsEl: document.getElementById('cart-actions'),
    });
  </script>
</BaseLayout>
