---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Carrinho">
  <div class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="text-2xl font-bold text-gray-900">Seu carrinho</h1>

    <div id="cart-empty" class="mt-10 hidden text-center text-gray-500">
      <p>Seu carrinho está vazio.</p>
      <a href="/catalogo" class="mt-3 inline-block font-medium text-brand-600 hover:underline">
        Ver catálogo →
      </a>
    </div>

    <div id="cart-items" class="mt-8 divide-y divide-gray-200"></div>

    <div id="cart-summary" class="mt-8 hidden border-t border-gray-200 pt-6">
      <div class="flex items-center justify-between text-lg font-bold text-gray-900">
        <span>Total estimado</span>
        <span id="cart-total">R$ 0,00</span>
      </div>
      <p class="mt-1 text-sm text-gray-500">Valor sujeito a confirmação de frete e disponibilidade.</p>
      <a
        id="checkout-link"
        href="#"
        target="_blank"
        rel="noopener"
        class="mt-6 block w-full rounded-md bg-green-600 py-3 text-center font-semibold text-white hover:bg-green-700"
      >
        Finalizar pedido pelo WhatsApp
      </a>
      <button
        id="clear-cart"
        class="mt-3 w-full rounded-md border border-gray-300 py-2.5 text-sm font-medium text-gray-600 hover:border-red-400 hover:text-red-600"
      >
        Esvaziar carrinho
      </button>
    </div>
  </div>

  <script>
    import {
      getCart,
      updateQty,
      removeFromCart,
      clearCart,
      getCartTotal,
      onCartUpdate,
      buildOrderMessage,
      formatBRL,
      type CartItem,
    } from '../scripts/cart';
    import { buildWhatsAppLink } from '../data/config';

    const itemsEl = document.getElementById('cart-items')!;
    const emptyEl = document.getElementById('cart-empty')!;
    const summaryEl = document.getElementById('cart-summary')!;
    const totalEl = document.getElementById('cart-total')!;
    const checkoutLink = document.getElementById('checkout-link') as HTMLAnchorElement;
    const clearBtn = document.getElementById('clear-cart')!;

    function renderItem(item: CartItem): HTMLElement {
      const row = document.createElement('div');
      row.className = 'flex items-center justify-between gap-4 py-4';
      row.innerHTML = `
        <div class="flex-1">
          <p class="font-medium text-gray-900">${item.nome}</p>
          <p class="text-sm text-gray-500">${formatBRL(item.preco)} / ${item.unidade}</p>
        </div>
        <input
          type="number"
          value="${item.qtd}"
          min="${item.qtdMinima}"
          step="${item.qtdMinima}"
          class="qty-input w-24 rounded-md border border-gray-300 px-2 py-1.5 text-sm"
        />
        <p class="w-24 text-right font-semibold text-gray-900">${formatBRL(item.preco * item.qtd)}</p>
        <button class="remove-btn text-sm text-gray-400 hover:text-red-600">Remover</button>
      `;

      const qtyInput = row.querySelector('.qty-input') as HTMLInputElement;
      qtyInput.addEventListener('change', () => {
        updateQty(item.id, Number(qtyInput.value) || item.qtdMinima);
      });

      const removeBtn = row.querySelector('.remove-btn') as HTMLButtonElement;
      removeBtn.addEventListener('click', () => removeFromCart(item.id));

      return row;
    }

    function render() {
      const items = getCart();
      itemsEl.innerHTML = '';

      if (items.length === 0) {
        emptyEl.classList.remove('hidden');
        summaryEl.classList.add('hidden');
        return;
      }

      emptyEl.classList.add('hidden');
      summaryEl.classList.remove('hidden');
      items.forEach((item) => itemsEl.appendChild(renderItem(item)));

      totalEl.textContent = formatBRL(getCartTotal());
      checkoutLink.href = buildWhatsAppLink(buildOrderMessage(items));
    }

    clearBtn.addEventListener('click', () => {
      if (confirm('Esvaziar o carrinho?')) clearCart();
    });

    render();
    onCartUpdate(render);
  </script>
</BaseLayout>
