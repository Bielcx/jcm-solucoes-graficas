---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products } from '../../data/products';

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const preco = product.preco.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
---

<BaseLayout title={product.nome} description={product.descricao}>
  <div class="mx-auto max-w-4xl px-4 pb-18 pt-10">
    <a href="/catalogo" class="text-sm text-ink-soft hover:text-olive-500">← Voltar ao catálogo</a>

    <div class="mt-6 grid gap-10 sm:grid-cols-2">
      <div
        class="flex aspect-square items-center justify-center overflow-hidden rounded-lg border border-cream-border bg-gradient-to-br from-[#efe8d6] to-[#e7dfc9]"
      >
        <img
          src={product.imagem}
          alt={product.nome}
          class="h-full w-full object-cover"
          onerror="this.src='/images/placeholder.svg'"
        />
      </div>

      <div>
        <h1 class="font-display text-[clamp(26px,3vw,36px)] font-bold leading-[1.15] text-ink">
          {product.nome}
        </h1>
        <p class="mt-3.5 text-[15.5px] leading-relaxed text-ink-soft">{product.descricao}</p>

        <div class="mt-6 flex items-baseline gap-2.5">
          <span class="font-display text-[28px] font-bold whitespace-nowrap text-olive-500">
            {preco}
          </span>
          <span class="text-[13px] text-ink-soft">/ {product.unidade}</span>
        </div>
        <p class="mt-1.5 text-[13px] text-ink-faint">
          Quantidade mínima: {product.qtdMinima} unidades
        </p>

        <form
          id="add-to-cart-form"
          class="mt-6 flex flex-wrap items-end gap-3"
          data-id={product.id}
          data-nome={product.nome}
          data-preco={product.preco}
          data-unidade={product.unidade}
          data-qtd-minima={product.qtdMinima}
        >
          <div>
            <label
              for="qtd"
              class="block font-display text-xs font-semibold uppercase tracking-[0.08em] text-ink"
            >
              Quantidade
            </label>
            <div
              class="mt-1.5 flex items-stretch overflow-hidden rounded-md border border-cream-border bg-surface"
            >
              <button
                type="button"
                id="qtd-menos"
                class="w-[38px] text-[17px] text-olive-500 hover:bg-cream"
                aria-label="Diminuir quantidade"
              >
                −
              </button>
              <input
                type="number"
                id="qtd"
                name="qtd"
                value={product.qtdMinima}
                min={product.qtdMinima}
                step={product.qtdMinima}
                class="w-16 border-x border-cream-border bg-transparent text-center font-display text-[15px] font-semibold text-ink [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
              />
              <button
                type="button"
                id="qtd-mais"
                class="w-[38px] text-[17px] text-olive-500 hover:bg-cream"
                aria-label="Aumentar quantidade"
              >
                +
              </button>
            </div>
          </div>
          <button
            type="submit"
            class="whitespace-nowrap rounded-md bg-olive-500 px-[26px] py-[13px] font-display text-sm font-semibold text-cream hover:bg-olive-600"
          >
            Adicionar ao carrinho
          </button>
        </form>
        <p id="add-to-cart-feedback" class="mt-2.5 hidden text-[13.5px] font-semibold text-olive-500">
          Adicionado ao carrinho ✓
        </p>

        {
          product.personalizavel && (
            <div class="mt-8 rounded-lg border border-dashed border-[#c9bfa6] bg-surface/70 p-[18px_20px]">
              <p class="text-sm text-ink">
                Quer esse produto com a sua marca ou arte personalizada?
              </p>
              <a
                href={`/orcamento?produto=${encodeURIComponent(product.nome)}`}
                class="mt-2 inline-block border-b border-olive-500 pb-0.5 font-display text-[13.5px] font-semibold text-olive-500 hover:text-olive-600"
              >
                Pedir orçamento personalizado →
              </a>
            </div>
          )
        }
      </div>
    </div>
  </div>

  <script>
    import { addToCart } from '../../scripts/cart';

    const form = document.getElementById('add-to-cart-form') as HTMLFormElement | null;
    const feedback = document.getElementById('add-to-cart-feedback');
    const qtdInput = document.getElementById('qtd') as HTMLInputElement | null;
    const qtdMenos = document.getElementById('qtd-menos');
    const qtdMais = document.getElementById('qtd-mais');

    // stepUp/stepDown nativos já respeitam min e step do input.
    qtdMenos?.addEventListener('click', () => qtdInput?.stepDown());
    qtdMais?.addEventListener('click', () => qtdInput?.stepUp());

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const qtdMinima = Number(form.dataset.qtdMinima);
      const qtd = Math.max(qtdMinima, Number(qtdInput?.value) || qtdMinima);

      addToCart(
        {
          id: form.dataset.id!,
          nome: form.dataset.nome!,
          preco: Number(form.dataset.preco),
          unidade: form.dataset.unidade!,
          qtdMinima,
        },
        qtd
      );

      if (feedback) {
        feedback.classList.remove('hidden');
        setTimeout(() => feedback.classList.add('hidden'), 2000);
      }
    });
  </script>
</BaseLayout>
