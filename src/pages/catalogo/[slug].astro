---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products } from '../../data/products';

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const preco = product.preco.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
---

<BaseLayout title={product.nome} description={product.descricao}>
  <div class="mx-auto max-w-5xl px-4 py-10">
    <a href="/catalogo" class="text-sm text-gray-500 hover:text-brand-600">← Voltar ao catálogo</a>

    <div class="mt-4 grid gap-10 sm:grid-cols-2">
      <div class="aspect-square overflow-hidden rounded-lg bg-gray-100">
        <img
          src={product.imagem}
          alt={product.nome}
          class="h-full w-full object-cover"
          onerror="this.src='/images/placeholder.svg'"
        />
      </div>

      <div>
        <h1 class="text-2xl font-bold text-gray-900">{product.nome}</h1>
        <p class="mt-2 text-gray-600">{product.descricao}</p>

        <p class="mt-4 text-2xl font-bold text-brand-700">
          {preco} <span class="text-sm font-normal text-gray-500">/ {product.unidade}</span>
        </p>
        <p class="mt-1 text-sm text-gray-500">Quantidade mínima: {product.qtdMinima} unidades</p>

        <form
          id="add-to-cart-form"
          class="mt-6 flex items-end gap-3"
          data-id={product.id}
          data-nome={product.nome}
          data-preco={product.preco}
          data-unidade={product.unidade}
          data-qtd-minima={product.qtdMinima}
        >
          <div>
            <label for="qtd" class="block text-sm font-medium text-gray-700">Quantidade</label>
            <input
              type="number"
              id="qtd"
              name="qtd"
              value={product.qtdMinima}
              min={product.qtdMinima}
              step={product.qtdMinima}
              class="mt-1 w-28 rounded-md border border-gray-300 px-3 py-2 text-sm"
            />
          </div>
          <button
            type="submit"
            class="rounded-md bg-brand-600 px-6 py-2.5 font-semibold text-white hover:bg-brand-700"
          >
            Adicionar ao carrinho
          </button>
        </form>
        <p id="add-to-cart-feedback" class="mt-2 hidden text-sm font-medium text-green-600">
          Adicionado ao carrinho!
        </p>

        {
          product.personalizavel && (
            <div class="mt-8 rounded-lg border border-brand-100 bg-brand-50 p-4">
              <p class="text-sm text-gray-700">
                Quer esse produto com a sua marca ou arte personalizada?
              </p>
              <a
                href={`/orcamento?produto=${encodeURIComponent(product.nome)}`}
                class="mt-2 inline-block text-sm font-semibold text-brand-700 hover:underline"
              >
                Pedir orçamento personalizado →
              </a>
            </div>
          )
        }
      </div>
    </div>
  </div>

  <script>
    import { addToCart } from '../../scripts/cart';

    const form = document.getElementById('add-to-cart-form') as HTMLFormElement | null;
    const feedback = document.getElementById('add-to-cart-feedback');

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const qtdMinima = Number(form.dataset.qtdMinima);
      const qtdInput = document.getElementById('qtd') as HTMLInputElement | null;
      const qtd = Math.max(qtdMinima, Number(qtdInput?.value) || qtdMinima);

      addToCart(
        {
          id: form.dataset.id!,
          nome: form.dataset.nome!,
          preco: Number(form.dataset.preco),
          unidade: form.dataset.unidade!,
          qtdMinima,
        },
        qtd
      );

      if (feedback) {
        feedback.classList.remove('hidden');
        setTimeout(() => feedback.classList.add('hidden'), 2000);
      }
    });
  </script>
</BaseLayout>
