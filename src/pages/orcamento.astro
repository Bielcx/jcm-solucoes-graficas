---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Orçamento personalizado">
  <div class="mx-auto max-w-[640px] px-4 pb-18 pt-14">
    <p class="font-display text-xs font-semibold uppercase tracking-[0.22em] text-olive-500">
      Sob medida
    </p>
    <h1 class="mt-3 font-display text-[clamp(28px,3.5vw,40px)] font-bold text-ink">
      Orçamento personalizado
    </h1>
    <p class="mt-2.5 text-[15.5px] leading-relaxed text-ink-soft">
      Conta o que você precisa e a solicitação já chega montada no nosso WhatsApp. Se já tiver
      arte ou logo, manda na conversa.
    </p>

    <form
      id="orcamento-form"
      class="mt-8 flex flex-col gap-5 rounded-lg border border-cream-border bg-surface p-[28px_26px]"
    >
      <div>
        <label
          for="nome"
          class="block font-display text-xs font-semibold uppercase tracking-[0.08em] text-ink"
        >
          Nome
        </label>
        <input
          type="text"
          id="nome"
          required
          class="mt-1.5 w-full rounded-md border border-cream-border bg-cream px-3 py-[11px] text-sm text-ink outline-none focus:border-olive-500"
        />
      </div>

      <div>
        <label
          for="produto"
          class="block font-display text-xs font-semibold uppercase tracking-[0.08em] text-ink"
        >
          Produto de interesse
        </label>
        <input
          type="text"
          id="produto"
          placeholder="Ex: Caixa de Pizza 35cm, sacola personalizada..."
          class="mt-1.5 w-full rounded-md border border-cream-border bg-cream px-3 py-[11px] text-sm text-ink outline-none focus:border-olive-500"
        />
      </div>

      <div>
        <label
          for="quantidade"
          class="block font-display text-xs font-semibold uppercase tracking-[0.08em] text-ink"
        >
          Quantidade estimada
        </label>
        <input
          type="text"
          id="quantidade"
          placeholder="Ex: 200 unidades"
          class="mt-1.5 w-full rounded-md border border-cream-border bg-cream px-3 py-[11px] text-sm text-ink outline-none focus:border-olive-500"
        />
      </div>

      <div>
        <label
          for="detalhes"
          class="block font-display text-xs font-semibold uppercase tracking-[0.08em] text-ink"
        >
          Detalhes da personalização
        </label>
        <textarea
          id="detalhes"
          rows="4"
          placeholder="Cores, logo, tamanho, prazo desejado..."
          class="mt-1.5 w-full resize-y rounded-md border border-cream-border bg-cream px-3 py-[11px] text-sm text-ink outline-none focus:border-olive-500"
        ></textarea>
      </div>

      <button
        type="submit"
        class="rounded-md bg-olive-500 py-[15px] font-display text-[15px] font-semibold text-cream hover:bg-olive-600"
      >
        Enviar pelo WhatsApp
      </button>
      <p class="text-center text-xs text-ink-faint">
        Sem cadastro — abre direto a conversa no WhatsApp.
      </p>
    </form>
  </div>

  <script>
    import { buildWhatsAppLink } from '../data/config';

    const params = new URLSearchParams(window.location.search);
    const produtoParam = params.get('produto');
    if (produtoParam) {
      const produtoInput = document.getElementById('produto') as HTMLInputElement;
      produtoInput.value = produtoParam;
    }

    const form = document.getElementById('orcamento-form') as HTMLFormElement;
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const nome = (document.getElementById('nome') as HTMLInputElement).value;
      const produto = (document.getElementById('produto') as HTMLInputElement).value;
      const quantidade = (document.getElementById('quantidade') as HTMLInputElement).value;
      const detalhes = (document.getElementById('detalhes') as HTMLTextAreaElement).value;

      const linhas = [
        'Olá! Gostaria de um orçamento personalizado.',
        '',
        `Nome: ${nome}`,
      ];
      if (produto) linhas.push(`Produto: ${produto}`);
      if (quantidade) linhas.push(`Quantidade estimada: ${quantidade}`);
      if (detalhes) linhas.push(`Detalhes: ${detalhes}`);

      window.open(buildWhatsAppLink(linhas.join('\n')), '_blank');
    });
  </script>
</BaseLayout>
